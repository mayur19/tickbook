{
  "name": "@tickbook/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli.ts seed",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/cli.ts reset"
  },
  "dependencies": {
    "@tickbook/shared": "0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  }
}
