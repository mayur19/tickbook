# Tickbook local configuration. run.sh copies this to .env and fills in secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4106
WEB_PORT=5106
APP_ORIGIN=http://localhost:5106
LOG_LEVEL=info
# Local socket connection as the current OS user (no password).
DATABASE_URL=postgres:///tickbook_dev?host=/tmp
TEST_DATABASE_URL=postgres:///tickbook_test?host=/tmp
SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=12
# Login attempts per client IP per minute (all emails). Per-email backoff is built in.
LOGIN_RATE_LIMIT_PER_MINUTE=30
REGISTER_RATE_LIMIT_PER_HOUR=5
# Reverse proxy trust: false (default), a hop count such as 1, or proxy IPs/CIDRs
# such as 127.0.0.1,10.0.0.0/8. Required (explicitly) when NODE_ENV=production.
TRUST_PROXY=false
